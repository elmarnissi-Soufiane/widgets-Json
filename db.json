{
    "pages": [{
            "id": "home",
            "title": "Page d'accueil",
            "description": "Bienvenue sur la page d'accueil.",
            "widgets": [{
                    "type": "header",
                    "id": "home-header",
                    "text": "Page d'accueil",
                    "css": {
                        "font-size": "32px",
                        "color": "green",
                        "text-align": "center",
                        "margin-bottom": "30px"
                    }
                },
                {
                    "type": "paragraph",
                    "id": "home-description",
                    "text": "Découvrez nos cartes ci-dessous. Cliquez pour en savoir plus !",
                    "css": {
                        "font-size": "18px",
                        "color": "#666",
                        "text-align": "center"
                    }
                },
                {
                    "type": "section",
                    "id": "home-cards",
                    "css": {
                        "display": "grid",
                        "grid-template-columns": "repeat(auto-fill, minmax(300px, 1fr))",
                        "gap": "20px",
                        "justify-items": "center",
                        "align-items": "center",
                        "width": "80%",
                        "margin": "0 auto",
                        "min-height": "100vh",
                        "text-align": "center"
                    },
                    "widgets": [{
                            "type": "card",
                            "id": "card1",
                            "image": "https://via.placeholder.com/300x200",
                            "title": "Titre de la Carte 1",
                            "description": "Une description simple de cette carte pour attirer l'attention.",
                            "button": {
                                "text": "En savoir plus",
                                "css": {
                                    "background-color": "green",
                                    "color": "white",
                                    "padding": "15px 30px",
                                    "border-radius": "5px",
                                    "cursor": "pointer"
                                }
                            },
                            "css": {
                                "width": "300px",
                                "border-radius": "10px",
                                "box-shadow": "0px 4px 6px rgba(0, 0, 0, 0.1)",
                                "overflow": "hidden",
                                "text-align": "center",
                                "margin-bottom": "20px"
                            }
                        },
                        {
                            "type": "card",
                            "id": "card2",
                            "image": "https://via.placeholder.com/300x200",
                            "title": "Titre de la Carte 2",
                            "description": "Découvrez des détails intéressants sur cette carte.",
                            "button": {
                                "text": "En savoir plus",
                                "css": {
                                    "background-color": "green",
                                    "color": "white",
                                    "padding": "15px 30px",
                                    "border-radius": "5px",
                                    "cursor": "pointer"
                                }
                            },
                            "css": {
                                "width": "300px",
                                "border-radius": "10px",
                                "box-shadow": "0px 4px 6px rgba(0, 0, 0, 0.1)",
                                "overflow": "hidden",
                                "text-align": "center",
                                "margin-bottom": "20px"
                            }
                        },
                        {
                            "type": "card",
                            "id": "card3",
                            "image": "https://via.placeholder.com/300x200",
                            "title": "Titre de la Carte 3",
                            "description": "Ajoutez une petite description pour rendre cette carte attrayante.",
                            "button": {
                                "text": "En savoir plus",
                                "css": {
                                    "background-color": "green",
                                    "color": "white",
                                    "padding": "15px 30px",
                                    "border-radius": "5px",
                                    "cursor": "pointer"
                                }
                            },
                            "css": {
                                "width": "300px",
                                "border-radius": "10px",
                                "box-shadow": "0px 4px 6px rgba(0, 0, 0, 0.1)",
                                "overflow": "hidden",
                                "text-align": "center",
                                "margin-bottom": "20px"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "about",
            "title": "À propos",
            "description": "Ceci est une page d'information.",
            "widgets": [{
                    "type": "header",
                    "id": "about-header",
                    "text": "About Us",
                    "css": {
                        "font-size": "32px",
                        "color": "green",
                        "text-align": "center",
                        "margin-bottom": "30px"
                    }
                },
                {
                    "type": "paragraph",
                    "id": "about-paragraph",
                    "text": "Welcome to our website! We aim to deliver the best experience for our users.",
                    "css": {
                        "font-size": "16px",
                        "color": "#666",
                        "text-align": "center"
                    }
                },
                {
                    "type": "section",
                    "id": "contact-section",
                    "title": "Contact Us",
                    "widgets": [{
                        "type": "form",
                        "id": "contact-form",
                        "action": "/submit",
                        "method": "POST",
                        "css": {
                            "display": "flex",
                            "flex-direction": "column",
                            "justify-content": "center",
                            "align-items": "center",
                            "position": "absolute",
                            "top": "50%",
                            "left": "50%",
                            "transform": "translate(-50%, -50%)",
                            "width": "400px",
                            "padding": "20px",
                            "background-color": "white",
                            "border-radius": "8px",
                            "box-shadow": "0px 4px 6px rgba(0, 0, 0, 0.1)"
                        },
                        "widgets": [{
                                "type": "input",
                                "id": "name-input",
                                "name": "name",
                                "placeholder": "Your name",
                                "css": {
                                    "width": "100%",
                                    "padding": "10px",
                                    "font-size": "14px",
                                    "border": "1px solid #ddd",
                                    "border-radius": "4px",
                                    "box-sizing": "border-box"
                                }
                            },
                            {
                                "type": "input",
                                "id": "email-input",
                                "name": "email",
                                "placeholder": "Your email",
                                "css": {
                                    "width": "100%",
                                    "padding": "10px",
                                    "font-size": "14px",
                                    "border": "1px solid #ddd",
                                    "border-radius": "4px",
                                    "box-sizing": "border-box"
                                }
                            },
                            {
                                "type": "textarea",
                                "id": "message-input",
                                "name": "message",
                                "placeholder": "Your message",
                                "css": {
                                    "width": "100%",
                                    "padding": "10px",
                                    "font-size": "14px",
                                    "border": "1px solid #ddd",
                                    "border-radius": "4px",
                                    "box-sizing": "border-box"
                                },
                                "rows": 4
                            },
                            {
                                "type": "button",
                                "id": "submit-button",
                                "text": "Submit",
                                "css": {
                                    "background-color": "#1e90ff",
                                    "color": "white",
                                    "padding": "10px 15px",
                                    "font-size": "16px",
                                    "border": "none",
                                    "border-radius": "4px",
                                    "cursor": "pointer",
                                    "transition": "background-color 0.3s"
                                }
                            }
                        ]
                    }]
                }
            ]
        },
        {
            "id": "nav",
            "title": "Navigation",
            "description": "Page de navigation avec les liens principaux.",
            "widgets": [{
                "type": "nav",
                "id": "main-nav",
                "links": [{
                        "text": "Page d'accueil",
                        "url": "/home",
                        "css": {
                            "font-size": "18px",
                            "color": "green",
                            "text-decoration": "none",
                            "padding": "10px"
                        }
                    },
                    {
                        "text": "À propos",
                        "url": "/about",
                        "css": {
                            "font-size": "18px",
                            "color": "green",
                            "text-decoration": "none",
                            "padding": "10px"
                        }
                    },
                    {
                        "text": "Contact",
                        "url": "/contact",
                        "css": {
                            "font-size": "18px",
                            "color": "green",
                            "text-decoration": "none",
                            "padding": "10px"
                        }
                    }
                ],
                "css": {
                    "display": "flex",
                    "justify-content": "center",
                    "background-color": "#f4f4f4",
                    "padding": "10px",
                    "box-shadow": "0px 4px 6px rgba(0, 0, 0, 0.1)"
                }
            }]
        }
    ]
}